SERVICE_NAME=billing-core
APP_ENV=development
LOG_LEVEL=INFO
SQL_ECHO=false
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/billing_core
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
INTERNAL_WEBHOOK_SIGNATURE=change-me-with-at-least-32-characters
ASAAS_API_TOKEN=change-me
ASAAS_WEBHOOK_SECRET=change-me-with-at-least-32-characters
ASAAS_SANDBOX=true
INTERNAL_API_CLIENTS={"neectify_shop":{"api_key":"change-me","scopes":["subscriptions:create","subscriptions:cancel","payments:create","payments:read","jobs:read","metrics:read"]}}
CORS_ALLOW_ORIGINS=["https://billing.neectify.local"]
ALLOWED_INTERNAL_WEBHOOK_HOSTS=["hooks.neectify.local"]
TRUST_PROXY_HEADERS=false
INTERNAL_RATE_LIMIT_REQUESTS=60
INTERNAL_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_RATE_LIMIT_REQUESTS=120
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_REPLAY_TTL_SECONDS=300
WEBHOOK_PROCESSING_LOCK_TTL_SECONDS=300
JOB_METADATA_TTL_SECONDS=86400
SUBSCRIPTION_IDEMPOTENCY_TTL_SECONDS=86400
WORKER_JOB_TIMEOUT_SECONDS=120
WORKER_KEEP_RESULT_SECONDS=3600
WORKER_MAX_TRIES=3
WORKER_RETRY_BACKOFF_SECONDS=30
WORKER_DEAD_LETTER_TTL_SECONDS=604800
WORKER_MAX_JOBS=10
INTERNAL_WEBHOOK_MAX_TRIES=5
API_MAX_PAGE_SIZE=100
ENABLE_METRICS_ENDPOINT=true
ENABLE_API_DOCS=true
MAX_REQUEST_BODY_BYTES=262144
MAX_WEBHOOK_BODY_BYTES=262144
